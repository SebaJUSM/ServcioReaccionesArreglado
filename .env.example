PROJECT_NAME=Reaction Service
API_V1_STR=/api/v1

DATABASE_URL=sqlite+aiosqlite:///./data/reactions.db
DATABASE_ECHO=false

EXTERNAL_VALIDATION_ENABLED=false
MESSAGES_SERVICE_URL=http://messages-service:8000/api/v1/messages
USERS_SERVICE_URL=http://users-service:8000/api/v1/users
VALIDATION_TIMEOUT_SECONDS=3
VALIDATION_SIMULATED_NOT_FOUND_ID=not-found

EVENTS_ENABLED=true
EVENTS_REQUIRED=false
RABBITMQ_DEFAULT_USER=reactions
RABBITMQ_DEFAULT_PASS=reactions_dev
# Local Python uses localhost; Compose configures its broker host as rabbitmq.
EVENT_BROKER_URL=amqp://reactions:reactions_dev@localhost:5672/
EVENT_EXCHANGE=reactions
EVENT_QUEUE=reactions.events
EVENT_ROUTING_KEY_PREFIX=reaction
EVENT_PUBLISH_RETRIES=3
EVENT_PUBLISH_RETRY_DELAY_SECONDS=0.5
EVENT_TIMEOUT_SECONDS=3
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
HEALTHCHECK_TIMEOUT_SECONDS=2
