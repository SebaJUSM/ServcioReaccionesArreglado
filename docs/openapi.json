    "/api/v1/reactions/{reaction_id}": {
      "delete": {
        "tags": [
          "Reactions"
        ],
        "summary": "Eliminar una reaccion",
        "operationId": "delete_reaction_api_v1_reactions__reaction_id__delete",
        "parameters": [
          {
            "name": "reaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Reaction Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource or route not found",
            "content": {
