  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "validation_error"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "Request validation failed"
            ]
          },
          "details": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "const": "ok",
            "title": "Database"
          },
          "events_enabled": {
            "type": "boolean",
            "title": "Events Enabled"
          },
          "rabbitmq_connected": {
            "type": "boolean",
            "title": "Rabbitmq Connected"
          },
          "outbox_pending": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Outbox Pending"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database",
          "events_enabled",
          "rabbitmq_connected",
          "outbox_pending"
        ],
        "title": "HealthResponse"
      },
      "MessageReactionsResponse": {
        "properties": {
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "total_reactions": {
            "type": "integer",
            "title": "Total Reactions"
          },
          "summary": {
            "items": {
              "$ref": "#/components/schemas/ReactionSummary"
            },
            "type": "array",
            "title": "Summary"
          },
          "reactions": {
            "items": {
              "$ref": "#/components/schemas/ReactionResponse"
            },
            "type": "array",
            "title": "Reactions"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "total_reactions",
          "summary",
          "reactions"
        ],
        "title": "MessageReactionsResponse",
        "description": "Esquema utilizado para responder a un GET del listado de reacciones de un mensaje.\nRetorna el id del mensaje, conteo total, el resumen por tipo, y la lista detallada."
      },
      "ReactionCreate": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Message Id",
            "description": "ID del mensaje al cual se reacciona",
            "examples": [
              "msg-1234"
            ]
          },
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id",
            "description": "ID del usuario que realiza la reacci\u00f3n",
            "examples": [
              "usr-5678"
            ]
          },
          "reaction_type": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[a-z0-9_-]+$",
            "title": "Reaction Type",
            "description": "Nombre de reaccion; se normaliza a minusculas (ej: like, heart, sad)",
            "examples": [
              "like"
            ]
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "user_id",
          "reaction_type"
        ],
        "title": "ReactionCreate",
        "description": "Esquema utilizado para recibir los datos de creaci\u00f3n (Body del POST).\nHereda todo de ReactionBase."
      },
      "ReactionResponse": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Message Id",
            "description": "ID del mensaje al cual se reacciona",
            "examples": [
              "msg-1234"
            ]
          },
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id",
            "description": "ID del usuario que realiza la reacci\u00f3n",
            "examples": [
              "usr-5678"
            ]
          },
          "reaction_type": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[a-z0-9_-]+$",
            "title": "Reaction Type",
            "description": "Nombre de reaccion; se normaliza a minusculas (ej: like, heart, sad)",
            "examples": [
              "like"
            ]
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Identificador \u00fanico de la reacci\u00f3n",
            "example": "reac-9012"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Fecha y hora de la creaci\u00f3n"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "user_id",
          "reaction_type",
          "id",
          "created_at"
        ],
        "title": "ReactionResponse",
        "description": "Esquema utilizado para la respuesta cuando se crea o se solicita una reacci\u00f3n individual.\nA\u00f1ade los campos generados por el sistema (id, created_at)."
      },
      "ReactionSummary": {
        "properties": {
          "reaction_type": {
            "type": "string",
            "title": "Reaction Type"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "reaction_type",
          "count"
        ],
        "title": "ReactionSummary",
        "description": "Esquema para un resumen de contadores por tipo de reacci\u00f3n.\nEj: reaction_type='like', count=5"
      },
      "ValidationIssue": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          }
        },
        "type": "object",
        "required": [
          "type",
          "loc",
          "msg"
        ],
        "title": "ValidationIssue"
      }
    }
  }
}
